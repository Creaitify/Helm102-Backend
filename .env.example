# ==============================================================================
# HELM02 Environment Configuration Template
# ==============================================================================

# Active LLM Provider Selection: "gemini" | "anthropic" | "replay"
DEFAULT_LLM_PROVIDER=gemini
HELM_LLM_PROVIDER=gemini

# ------------------------------------------------------------------------------
# Google Gemini Provider
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# Anthropic Claude Provider
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_FAST_MODEL=claude-3-5-haiku-20241022

# ------------------------------------------------------------------------------
# Governed System & Ad-Platform Execution Settings
# ------------------------------------------------------------------------------
HELM_ADS_DRY_RUN=true
HELM_SECRETS_DIR=services/api/data
DAILY_SPEND_LIMIT_MICRODOLLARS=50000000

# ------------------------------------------------------------------------------
# Google Ads OAuth (Google Cloud Console -> APIs & Services -> Credentials)
# Create a "Web application" OAuth client; authorized redirect URI must be
# {HELM_PUBLIC_URL}/api/oauth/google/callback
# developer_token + customer_id are entered via POST /api/connections/google
# ------------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=your_cloud_console_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_cloud_console_oauth_client_secret
HELM_PUBLIC_URL=http://127.0.0.1:8000
