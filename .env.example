# ==============================================================================
# HELM Environment Configuration Template
# Copy to `.env` and fill in what you need. Nothing here is required to run:
# with no keys at all, HELM serves synthetic data in replay mode.
# ==============================================================================

# ------------------------------------------------------------------------------
# Model gateway
# Provider selection: "gemini" | "anthropic" | "replay"
# Without a key the gateway runs in replay mode: metrics, compliance verdicts and
# budget math are still real; only narrative prose comes from templates.
# ------------------------------------------------------------------------------
HELM_LLM_PROVIDER=gemini

# ------------------------------------------------------------------------------
# Google Gemini Provider
# Supported Models: "gemini-3.1-flash", "gemini-3.5-flash", "gemini-2.5-flash", "gemini-2.5-pro", "gemini-2.0-flash"
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Daily model-spend ceiling enforced by the gateway ledger (micro-dollars).
DAILY_SPEND_LIMIT_MICRODOLLARS=50000000

# ------------------------------------------------------------------------------
# Server
# ------------------------------------------------------------------------------
PORT=8000
HELM_PUBLIC_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# Ad-platform execution safety
# HELM_ADS_DRY_RUN=true previews the exact payload instead of dispatching it.
# Set to false ONLY when you intend real budget changes on live accounts.
# Human approval is required either way.
# ------------------------------------------------------------------------------
HELM_ADS_DRY_RUN=true

# Where the credential vault is written (server-side custody).
HELM_SECRETS_DIR=services/api/data

# ------------------------------------------------------------------------------
# Google Ads (Google Cloud Console -> APIs & Services -> Credentials)
# Create a "Web application" OAuth client whose authorized redirect URI is
#   {HELM_PUBLIC_URL}/api/oauth/google/callback
# The developer token and customer id are entered in Settings -> Connections,
# or posted to /api/connections/google. They are never stored in this file.
# ------------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# Local state (SQLite). Defaults are fine for development.
# ------------------------------------------------------------------------------
# HELM_CONVERSATIONS_DB=services/api/data/helm_conversations.sqlite
# HELM_REPORTS_DB=services/api/data/helm_reports.sqlite
